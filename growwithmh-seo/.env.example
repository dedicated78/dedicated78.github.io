# -----------------------------------------------------------------------------
# GrowwithMH SEO — self-host config
#
#   cp .env.example .env   then fill in DATAFORSEO_API_KEY and run:
#   docker compose up -d --build
#
# Only DATAFORSEO_API_KEY is required. Everything else has a working default.
# -----------------------------------------------------------------------------

# REQUIRED. Base64 of "your-dataforseo-login:your-dataforseo-password".
# Generate it:  printf '%s' 'login:password' | base64
# Full walkthrough: docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Port the container publishes on 127.0.0.1. Change it if 3001 is taken.
PORT=3001

# Public hostname when you put this behind Nginx/Caddy on a VPS. Vite's preview
# server rejects any Host header not listed here, so a proxied domain 403s
# without it. Leave blank for pure localhost use.
# ALLOWED_HOST=seo.growwithmh.com

# -----------------------------------------------------------------------------
# Deployment posture  (Phase 2)
# -----------------------------------------------------------------------------
# "production" (default) or "development".
#
# AUTH_MODE=local_noauth gives EVERY caller full admin access with no
# credential. Since Phase 2 the app refuses to start in that mode unless the
# deployment declares itself development, so a forgotten setting fails closed
# instead of booting wide open.
DEPLOYMENT_MODE=development

# Bearer token required by the MCP endpoint (/mcp) outside Cloudflare Access.
# Until Phase 2 that endpoint was completely unauthenticated while serving 46
# tools that spend your DataForSEO balance.
#
# Leave unset ONLY on a private development machine with
# DEPLOYMENT_MODE=development; a production deployment refuses MCP without it.
# Generate one:  openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Temporary TEST deployments only (e.g. Hostinger Web App).
#
# One shared HTTP Basic password in front of the WHOLE application, so
# AUTH_MODE=local_noauth is never anonymously reachable on a public URL. It
# grants nothing and makes nobody an administrator — it only decides whether a
# request reaches the app. /api/health stays open for platform health probes.
#
# Leave unset for normal deployments; the gate is then entirely inert.
# Required if you expose a local_noauth deployment on a public hostname.
# See HOSTINGER_WEBAPP_TEST.md.
# TEST_ACCESS_PASSWORD=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Docker mode is pinned to AUTH_MODE=local_noauth in compose.yaml: no login
# screen, everything runs as admin@localhost. That is why the port is bound to
# 127.0.0.1 only. If you expose it on a domain, put auth in front of it
# (Cloudflare Access, Cloudflare Tunnel, Authelia, or Nginx basic auth).

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------

# SAM, the in-app SEO agent. Hidden entirely while unset — the SEO data
# features all work without it. Key: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Google Search Console: real clicks/impressions/positions inside the app and
# over MCP. Needs all three. BETTER_AUTH_SECRET encrypts the stored OAuth
# tokens — generate with: openssl rand -base64 48
# See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Telemetry
# -----------------------------------------------------------------------------
# compose.yaml defaults this install to opted out. Set to an empty value to
# send upstream the anonymous heartbeat instead.
OPENSEO_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# Image override
# -----------------------------------------------------------------------------
# compose.yaml builds from this checkout so the GrowwithMH branding is included.
# Point this at a published upstream tag to skip the local build (branding is
# then upstream's, not yours).
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest
