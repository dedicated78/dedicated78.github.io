{
  "name": "growwithmh-intro-video",
  "private": true,
  "version": "1.0.0",
  "description": "GrowwithMH 40s 9:16 company introduction video (Remotion)",
  "scripts": {
    "audio": "node scripts/prepare-music.mjs",
    "studio": "node scripts/prepare-music.mjs && remotion studio src/index.ts",
    "render": "node scripts/prepare-music.mjs && remotion render src/index.ts GrowwithMHIntro out/growwithmh-intro.mp4",
    "still": "remotion still src/index.ts GrowwithMHIntro out/still.png",
    "player": "node scripts/prepare-music.mjs && node scripts/build-player.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.300",
    "@remotion/player": "4.0.300",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.300"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "typescript": "5.8.3"
  }
}
